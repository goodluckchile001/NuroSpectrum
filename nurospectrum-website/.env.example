# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Public canonical website origin, without a trailing slash.
# Set this to your production domain for correct canonical links and sitemap URLs.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
API_ORIGIN=http://localhost:8000

# Random secret used to encrypt sessions. Generate one with:  npx auth secret
AUTH_SECRET=

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Set true only after Google OAuth is configured in the backend.
NEXT_PUBLIC_GOOGLE_SIGN_IN_ENABLED=false

# Only needed when hosting somewhere other than Vercel:
# AUTH_TRUST_HOST=true
# AUTH_URL=https://your-domain.com
