# Copy to .env and fill in. Never commit .env.

# --- Core ---
DEBUG=true
# Required when DEBUG=false. Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Public URL of the Next.js site (used in links sent by allauth)
FRONTEND_URL=http://localhost:3000
# Production: https://your-site.com,https://www.your-site.com
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Only needed if the browser calls Django directly (no Next.js proxy)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Random path for the admin, e.g. manage-7f3k/ (keep the trailing slash)
ADMIN_URL=admin/

# --- Database (leave empty for local SQLite) ---
# DATABASE_URL=postgres://nurospectrum:nurospectrum@localhost:5432/nurospectrum

# --- Google sign-in (Google Cloud Console > Credentials > OAuth client, "Web application") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- WhatsApp: fallback invite link for states without their own ---
WHATSAPP_NATIONAL_URL=

# --- Email (partner inquiries, allauth) ---
INQUIRY_NOTIFY_EMAIL=
DEFAULT_FROM_EMAIL=Nurospectrum <no-reply@example.com>
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true

# --- Spam protection (Cloudflare Turnstile). Leave empty to disable. ---
TURNSTILE_SECRET_KEY=

# --- Behind a proxy/load balancer: how many proxies to trust for client IPs ---
# NUM_PROXIES=1
