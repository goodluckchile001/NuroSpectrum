# Production environment template for the Django service.
# Configure these values in the hosting provider; do not commit real secrets.
DEBUG=false
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
ALLOWED_HOSTS=nurospectrum.onrender.com
FRONTEND_URL=https://nurospectrum-website.vercel.app
CSRF_TRUSTED_ORIGINS=https://nurospectrum-website.vercel.app
ADMIN_URL=replace-with-a-random-admin-path/

# Use the internal connection URL from your managed PostgreSQL provider.
DATABASE_URL=

# Google Cloud OAuth web client. Leave blank only if Google sign-in is not ready.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional fallback; state-specific WhatsApp links are managed in Django admin.
WHATSAPP_NATIONAL_URL=

# Configure a real SMTP provider so inquiries and account emails are delivered.
INQUIRY_NOTIFY_EMAIL=
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Set the secret key if Turnstile is enabled on the frontend.
TURNSTILE_SECRET_KEY=

# Set MEDIA_ROOT to a persistent volume before accepting uploaded media.
# MEDIA_ROOT=/var/data/media
